#!/bin/sh
# Compass on-premise: доставка docker secrets в окружение приложения.
#
# Образы Compass читают пароли из переменных окружения, поэтому сервисы,
# которым нужны секреты, запускаются через этот шим:
#     entrypoint: ["/bin/sh", "/compass_secret_shim.sh"]
# Шим экспортирует каждый файл /run/secrets/<ИМЯ_ПЕРЕМЕННОЙ> (только из
# заглавных латинских букв, цифр и подчеркивания) как переменную окружения
# и запускает оригинальную команду образа (exec "$@" — приложение остается PID 1).
#
# Побочно пишет source-able файл /tmp/compass_secret_env — его подгружают
# управляющие скрипты установщика при docker exec (docker exec не видит
# переменные, экспортированные процессом контейнера).

DUMP=/tmp/compass_secret_env

: > "$DUMP" 2>/dev/null
chmod 644 "$DUMP" 2>/dev/null

for f in /run/secrets/*; do
    [ -f "$f" ] || continue
    name=${f##*/}
    case "$name" in
        ''|*[!A-Z0-9_]*) continue ;;
    esac
    val=$(cat "$f")
    eval "$name=\$val"
    export "$name"
    # export обязателен: файл source-ится обёртками docker exec (bash),
    # без export переменные не попадут в окружение дочернего php/mysql
    printf "export %s='%s'\n" "$name" "$val" >> "$DUMP" 2>/dev/null
done

exec "$@"
