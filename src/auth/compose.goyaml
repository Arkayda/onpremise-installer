version: '3.8'

# --- EXTENSIONS ---
# правила дефолтного деплоя для сервисов
# если нужно что-то поменять, то только через override-файл
x-default-deploy: &default-deploy
  deploy:
    replicas: 1
    restart_policy:
      condition: "any"
      window: "10s"
    update_config:
      order: "start-first"
      failure_action: "rollback"
      delay: "10s"
    rollback_config:
      parallelism: 0
      order: "stop-first"

# правила логирования для сервисов по умолчанию
# дефолтно просто пишем лог и ограничиваем его размер
x-log-rule-default: &log-rule-default
  logging:
    driver: "json-file"
    options:
      max-size: "15m"
      max-file: "3"

# entrypoint для сервисов, получающих пароли через docker secrets
x-secret-shim-entrypoint: &secret-shim-entrypoint
  entrypoint: ["/bin/sh", "/compass_secret_shim.sh"]

# пароли передаются через docker secrets, имена версионированы md5-ревизией
secrets:
  mysql-root-password:
    name: "{{.stack_name}}_mysql_root_password-{{.secret_revisions.secret.project.mysql_root_password}}"
    file: ".secret.project.mysql_root_password"
  mysql-pass:
    name: "{{.stack_name}}_mysql_pass-{{.secret_revisions.secret.project.mysql_root_password}}"
    file: ".secret.project.mysql_root_password"

configs:
  # шим доставки docker secrets в окружение приложений
  secret-shim:
    name: "{{.stack_name}}_secret_shim-{{.config_revisions.global.compass_secret_shim.sh}}"
    file: ".global.compass_secret_shim.sh"
  api-key-templates:
    name: "{{.stack_name}}_api_key_templates-{{.config_revisions.project.api_key_templates.json}}"
    file: ".project.api_key_templates.json"
  cache-config:
    name: "{{.stack_name}}_cache_config-{{.config_revisions.project.cache.json}}"
    file: ".project.cache.json"
services:

  # GO_AUTH
  go-auth-{{.projects.auth.label}}:
    image: "{{.registry_compass_path}}/go_auth:{{.projects.auth.service.go_auth.tag}}"
    depends_on:
      - "mysql-{{.projects.auth.label}}"
    ports:
      - "{{.projects.auth.service.go_auth.external_grpc_port}}:2000"
    env_file:
      - ".global.common.env"
      - ".project.common.env"
    <<: *secret-shim-entrypoint
    command: ["sh", "/app/entrypoint.sh"]
    secrets:
      - source: mysql-pass
        target: MYSQL_PASS
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
    networks:
      - "auth-private"
    deploy:
      replicas: 1
      restart_policy:
        condition: "any"
        window: "10s"
      update_config:
        order: "start-first"
        failure_action: "rollback"
        delay: "10s"
      rollback_config:
        parallelism: 0
        order: "stop-first"
    healthcheck:
      test: "nc -z 127.0.0.1 2000"
      interval: "5s"
      timeout: "25s"
      retries: 10
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"
    configs:
      - source: "secret-shim"
        target: "/compass_secret_shim.sh"
      - source: "api-key-templates"
        target: "/app/configs/api_key_templates.json"
      - source: "cache-config"
        target: "/app/configs/cache.json"
  # MYSQL
  mysql-{{.projects.auth.label}}:
    image: "{{.registry_service_path}}/mysql:8.0.28-1"
    networks:
      - "auth-private"
    environment:
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/MYSQL_ROOT_PASSWORD
    secrets:
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
    deploy:
      restart_policy:
        condition: "any"
        window: "10s"
    healthcheck:
      test: 'mysqladmin ping -h localhost -P 3306 -u root --password="$$(cat /run/secrets/MYSQL_ROOT_PASSWORD)"'
      interval: "5s"
      timeout: "10s"
      retries: 6
    <<: *log-rule-default

# --- DEFINES ---
networks:
  auth-private:
    driver: "overlay"
    ipam:
      config:
        - subnet: "{{.projects.auth.network.subnet}}"
