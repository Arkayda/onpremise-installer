version: '3.8'

# файл композиции для file-части
{{$file_node := index .projects.file .file_node_id}}

# entrypoint для сервисов, получающих пароли через docker secrets
# (шелл-шим читает /run/secrets/<ИМЯ_ПЕРЕМЕННОЙ> и экспортирует в окружение)
x-secret-shim-entrypoint: &secret-shim-entrypoint
  entrypoint: ["/bin/sh", "/compass_secret_shim.sh"]

# пароли передаются через docker secrets, имена версионированы md5-ревизией
secrets:
  mysql-root-password:
    name: "{{.stack_name}}_mysql_root_password-{{.secret_revisions.secret.project.mysql_root_password}}"
    file: ".secret.project.mysql_root_password"
  rabbit-password:
    name: "{{.stack_name}}_rabbit_password-{{.secret_revisions.secret.global.rabbit_password}}"
    file: ".secret.global.rabbit_password"

configs:

  # шим доставки docker secrets в окружение приложений
  secret-shim:
    name: "{{.stack_name}}_secret_shim-{{.config_revisions.global.compass_secret_shim.sh}}"
    file: ".global.compass_secret_shim.sh"

  # настройки коллектор-агента
  go-collector-agent-sharding-conf:
    name: "{{.stack_name}}_go_collector_agent_sharding-{{.config_revisions.global.go_collector_agent_sharding.json}}"
    file: ".global.go_collector_agent_sharding.json"
  nginx-sites:
    name: "{{.stack_name}}_nginx_sites-{{.config_revisions.project.nginx_sites.conf}}"
    file: ".project.nginx_sites.conf"
  nginx-include:
    name: "{{.stack_name}}_nginx_include-{{.config_revisions.project.nginx_include.conf}}"
    file: ".project.nginx_include.conf"
  nginx-conf:
    name: "{{.stack_name}}_nginx_conf-{{.config_revisions.global.nginx.conf}}"
    file: ".global.nginx.conf"
  file-auto-deletion-conf:
    name: "{{.stack_name}}_file_conf-{{.config_revisions.project.file_auto_deletion.conf}}"
    file: ".project.file_auto_deletion.conf"
services:
  ## NGINX
  nginx-{{$file_node.label}}:
    image: "{{.registry_service_path}}/nginx:master"
    networks:
      - "file-node-private"
    ports:
      - "{{$file_node.service.nginx.external_https_port}}:443"
    deploy:
      restart_policy:
        condition: "any"
        window: "10s"
    configs:
      - source: "nginx-sites"
        target: "/etc/nginx/sites-enabled/default"
      - source: "nginx-include"
        target: "/etc/nginx/includes/file.nginx"
      - source: "nginx-conf"
        target: "/etc/nginx/nginx.conf"
    volumes:
      - "{{.root_mount_path}}/nginx/ssl:/etc/nginx/ssl/"
      - "{{.root_mount_path}}/tmp_files:/tmp/files/"
      - "{{.root_mount_path}}/files:/home/files/"
  # MYSQL
  mysql-{{$file_node.label}}:
    image: "{{.registry_service_path}}/mysql:8.0.28"
    networks:
      - "file-node-private"
    environment:
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/MYSQL_ROOT_PASSWORD
    secrets:
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
    deploy:
      restart_policy:
        condition: "any"
        window: "10s"
    healthcheck:
      test: 'mysqladmin ping -h localhost -P 3306 -u root --password="$$(cat /run/secrets/MYSQL_ROOT_PASSWORD)"'
      interval: "5s"
      timeout: "10s"
      retries: 6
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"

  # RABBIT
  rabbit-{{$file_node.label}}:
    image: "{{.registry_service_path}}/rabbitmq:4.0.3-1"
    networks:
      - "file-node-private"
    env_file:
      - ".project.common.env"
    command: ["/app/entrypoint.sh"]
    configs:
      - source: "secret-shim"
        target: "/compass_secret_shim.sh"
    secrets:
      - source: rabbit-password
        target: RABBITMQ_DEFAULT_PASS
    deploy:
      replicas: 1
      restart_policy:
        condition: "any"
        window: "10s"
    <<: *secret-shim-entrypoint
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"

  # MEMCACHED
  memcached-{{$file_node.label}}:
    image: "{{.registry_service_path}}/memcached:3.23-1"
    networks:
      - "file-node-private"
    env_file:
      - ".project.common.env"
    deploy:
      replicas: 1
      restart_policy:
        condition: "any"
        window: "10s"
    healthcheck:
      test: "nc -z 127.0.0.1 11211"
      interval: "5s"
      timeout: "25s"
      retries: 3
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"

  # FILE_NODE
  php-file-node-{{$file_node.label}}:
    image: "{{.registry_compass_path}}/php_file_node:{{$file_node.service.php_file_node.tag}}"
    environment:
      NODE_ID: "1"
      NODE_URL: "{{.protocol}}://{{$file_node.subdomain}}.{{.domain}}/"
      VIDEO_PROCESS_THREAD_COUNT: "2"
    env_file:
      - ".global.common.env"
      - ".project.common.env"
      - ".project.php_file_node.env"
    # оригинальный ENTRYPOINT php-образа переносится в command
    command: ["bash", "/app/entrypoint.sh"]
    <<: *secret-shim-entrypoint
    secrets:
      - source: mysql-root-password
        target: MYSQL_PASS
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
      - source: mysql-root-password
        target: MYSQL_SYSTEM_PASS
      - source: rabbit-password
        target: RABBIT_PASS
      - source: rabbit-password
        target: RABBITMQ_DEFAULT_PASS
    configs:
      - source: "secret-shim"
        target: "/compass_secret_shim.sh"
    networks:
      - "file-node-private"
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"
    volumes:
      - "{{get_trusted_cert_path_by_os}}:/etc/ssl/certs:ro"
      - "{{.root_mount_path}}/tmp_files:/tmp/files/"
    healthcheck:
      test: "nc -z 127.0.0.1 9000"
      interval: "5s"
      timeout: "25s"
      retries: 10
  # GO_COLLECTOR_AGENT
  go-collector-agent-{{$file_node.label}}:
    image: "{{.registry_compass_path}}/go_collector_agent:{{$file_node.service.go_collector_agent.tag}}"
    depends_on:
      - "rabbit-{{$file_node.label}}"
    environment:
      HTTP_PORT: 2000
      TCP_PORT: 1000
    env_file:
      - ".global.common.env"
      - ".global.go_collector_request_balancing.env"
      - ".project.common.env"
      - ".project.php_file_node.env"
    <<: *secret-shim-entrypoint
    secrets:
      - source: mysql-root-password
        target: MYSQL_PASS
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
      - source: mysql-root-password
        target: MYSQL_SYSTEM_PASS
      - source: rabbit-password
        target: RABBIT_PASS
      - source: rabbit-password
        target: RABBITMQ_DEFAULT_PASS
    networks:
      - "file-node-private"
    configs:
      - source: "secret-shim"
        target: "/compass_secret_shim.sh"
      - source: "go-collector-agent-sharding-conf"
        target: "/app/api/conf/sharding.example.json"
      - source: "file-auto-deletion-conf"
        target: "/app/src/Compass/FileNode/api/conf/file.php"
    deploy:
      replicas: 1
      restart_policy:
        condition: "any"
        window: "10s"
      update_config:
        order: "start-first"
        failure_action: "rollback"
        delay: "10s"
      rollback_config:
        parallelism: 0
        order: "stop-first"
    healthcheck:
      test: "nc -z 127.0.0.1 1000 && nc -z 127.0.0.1 2000"
      interval: "5s"
      timeout: "25s"
      retries: 10
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"
    volumes:
      - "{{get_trusted_cert_path_by_os}}:/etc/ssl/certs:ro"

  {{- if eq .file_access_restriction_mode "auth"}}
  # GO_FILE_AUTH
  go-file-auth-{{$file_node.label}}:
    image: "{{.registry_compass_path}}/go_file_auth:{{$file_node.service.go_file_auth.tag}}"
    env_file:
      - ".global.common.env"
      - ".project.common.env"
      - ".project.go_file_auth.env"
    <<: *secret-shim-entrypoint
    secrets:
      - source: mysql-root-password
        target: MYSQL_PASS
      - source: mysql-root-password
        target: MYSQL_ROOT_PASSWORD
      - source: mysql-root-password
        target: MYSQL_SYSTEM_PASS
      - source: rabbit-password
        target: RABBIT_PASS
      - source: rabbit-password
        target: RABBITMQ_DEFAULT_PASS
    configs:
      - source: "secret-shim"
        target: "/compass_secret_shim.sh"
    networks:
      - "file-node-private"
      - "test-shared"
    environment:
      TCP_PORT: 1000
      GRPC_PORT: 2000
    deploy:
      replicas: 1
      restart_policy:
        condition: "any"
        window: "10s"
      update_config:
        order: "start-first"
        failure_action: "rollback"
        delay: "10s"
      rollback_config:
        parallelism: 0
        order: "stop-first"
    healthcheck:
      test: "nc -z 127.0.0.1 1000"
      interval: "5s"
      timeout: "25s"
      retries: 10
    logging:
      driver: "json-file"
      options:
        max-size: "15m"
        max-file: "3"
  {{- end}}

networks:
  file-node-private:
    driver: "overlay"
    ipam:
      config:
        - subnet: "{{$file_node.network.subnet}}"
