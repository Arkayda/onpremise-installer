    )

if not confirm(
        "Удаляем все данные приложения по пути %s, продолжить? [y/N]\n"
        % str(root_mount_path.resolve())
):
    scriptutils.die("Удаление данных было отменено")

# Команда удаления (все, кроме инсталлятора)
