def collect_docker_confirmation(confirm_all: bool = False) -> bool:
    """
    Собирает подтверждение на настройку Docker окружения.
    """

    if docker_manager.check_docker_installed():
        colors.print_info("Найден установленный Docker")
        return True

    if not ask_user(
