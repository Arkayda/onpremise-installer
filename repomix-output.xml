def create_host_certificate(host: str, ca_pubkey_path: Path, ca_privkey_path: Path):
    pubkey = "%s.crt" % host
    privkey = "%s.key" % host
    full_pem = "%s.pem" % host

    pubkey_path = Path(str(cert_path.resolve()) + "/" + pubkey)
    privkey_path = Path(str(cert_path.resolve()) + "/" + privkey)
