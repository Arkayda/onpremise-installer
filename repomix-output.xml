        tar.add("%s/deploy_configs" % current_values["root_mount_path"], arcname="deploy_configs")

    control_data = {"config_archive_name": "%s.tgz" % backup_name}
    write_control_file(backup_path_str, control_data)


# делаем бэкап монолита
