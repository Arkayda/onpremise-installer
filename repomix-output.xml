def get_values() -> Dict:
    default_values_file_path = Path("%s/../../../../src/values.yaml" % (script_dir))
    values_file_path = Path("%s/../../../../src/values.%s.yaml" % (script_dir, values_name))

    if not values_file_path.exists():
