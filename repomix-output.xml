# ----------------------------------------------
# Конфигурация каталога Smart Apps
# ----------------------------------------------

# Отображение приложений в каталоге.

# ВАЖНО: рекомендуется не вносить изменения в ID приложений в каталоге и не удалять
# приложения из списка, так как это может отразиться на их работе. При необходимости любое
# приложение может быть скрыто из каталога с помощью параметра is_need_show_in_catalog.

# Доступные параметры:
#
# catalog_item_id: ID приложения в рамках каталога.
# Тип данных: целое число
#
# is_popular: должно ли приложение отображаться в списке популярных. Возможные варианты:
# "0" – приложение не отображается в списке популярных;
# "1" – приложение отображается в списке популярных.
#
# sort_weight: значение для сортировки приложения в списке популярных. Чем больше значение,
# тем выше располагается приложение в списке популярных. Параметр действителен только при
# значении is_popular: 1
# Тип данных: целое число
#
# catalog_category: "категория каталога, в которой располагается приложение."
# Тип данных: строка
# - popular
# - office_apps
# - mail
# - calendars
# - team_collaboration
# - crm_systems
# - video_conferencing
# - messengers
# - development
# - file_storage
# - ai_services
# - accounting_and_edo
# - hr_services
# - analytics
# - other
#
# uniq_name: "уникальный ID приложения."
# Тип данных: целое число
#
# title: название приложения, видимое пользователям.
# Тип данных: строка
#
# url: URL-адрес, который открывается при запуске приложения.
# Тип данных: строка
#
# is_need_custom_user_agent: требуется ли использование специального user-agent при
# открытии приложения.
# Возможные варианты:
# "0" – приложение не использует специальный user-agent;
# "1" – приложение использует специальный user-agent.
#
# is_need_show_in_catalog: требуется ли отображать приложение в каталоге. Возможные варианты:
# "0" – приложение не отображается в каталоге;
# "1" – приложение отображается в каталоге.

# При добавлении собственных приложений в каталог используются вышеописанные параметры.
# Значения catalog_item_id и uniq_name должны быть уникальными и не должны пересекаться с уже
