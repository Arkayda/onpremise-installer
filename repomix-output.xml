<file path="yaml_template/configs/proxy.tpl.yaml">
# Протокол, по которому производится взаимодействие с прокси сервером.
# Если протокол не указан, прокси сервер не будет использоваться.
# Возможные значения: http, https, socks5, socks5h
#
# Тип данных: строка
# Пример: proxy.protocol: "http"
proxy.protocol: ""

# IP-адрес или доменное имя прокси сервера.
#
# Тип данных: строка
# Пример: proxy.host: "example.com"
proxy.host: ""

# Порт, который слушает прокси сервер.
#
# Тип данных: число
# Пример: proxy.port: 8081
proxy.port: 0

# Имя пользователя для авторизации на прокси сервере.
#
# Необязательный параметр. Используйте его, если прокси сервер требует аутентификацию.
#
# Тип данных: строка
# Пример: proxy.user: "user"
proxy.username: ""

# Пароль для аутентификации на прокси сервере
#
# Необязательный параметр. Используйте его, если прокси сервер требует аутентификацию.
#
# Тип данных: строка
# Пример: proxy.password: "qwerty"
proxy.password: ""
</file>

<file path="yaml_template/configs/replication.tpl.yaml">
# Метка для сервисов стака
# используется для разделения сервисов между разными стаками
# если используется один стак/сервер, значение должно быть пустой строкой
# Имя должно быть не длиннее 7 символов
#
# Тип данных: строка
# Пример: service_label: "primary"
service_label: ""

# server_id для установки репликации БД между стаками
# основной сервер имеет server_id; резервный server_id основного + 1
# каждый следующий резервный сервер должен иметь server_id, с инкрементом от предыдущего
# если используется один стак/сервер, значение должно быть = 0
#
# Тип данных: число
# Пример: mysql_server_id: 1
mysql_server_id: 0

# Начальный октет для подсети стака
# значение по умолчанию: 10
# пример: 172.39.x.0/24 => 172.39.10.0/24
# если поднимается дополнительный стак, start_octet для него должен иметь отличное от основного значение, рекомендуется указывать значение больше минимум на 4 от прошлого
#
# Тип данных: число
# Пример: start_octet: 10
start_octet: 10

# Запрещает автоматический переход сервера обратно в состояние Master.
# Используется, если сервер переключился в состояние Backup:
# в этом случае приложение не позволит автоматически вернуть его в состояние Master без ручного вмешательства администратора.
#
# Тип данных: булево значение, true\\false
# Пример: master_state_changed_disable: true
master_state_changed_disable: true
</file>

<file path="yaml_template/configs/siem.tpl.yaml">
# ----------------------------------------------
# НАСТРОЙКИ ИНТЕГРАЦИИ С SIEM ЧЕРЕЗ KAFKA
# ----------------------------------------------


# Включена ли интеграция с SIEM.
# При значении kafka приложение отправляет события в Kafka, и стек интеграции
# поднимается. При none отправка не производится, стек интеграции
# останавливается.
#
# Тип данных: строка, kafka\none
siem.enabled_driver: "none"

# Порт, на котором Kafka принимает внешние подключения SIEM.
#
# Тип данных: число
# Пример: siem.driver_data.listen_port: 9094
siem.driver_data.listen_port: 9094

# Имя пользователя Kafka, под которым SIEM подключается для чтения событий.
# Пользователю выдаётся доступ только на чтение топика raw.events.
#
# Тип данных: строка
# Пример: siem.driver_data.user: "siem"
siem.driver_data.user: ""

# Пароль пользователя из siem.driver_data.user.
# Внимание: файл siem.yaml содержит секрет — ограничьте права доступа к файлу.
# В пароле не используйте символы "," и "]", а также символ "!" в начале.
#
# Тип данных: строка
siem.driver_data.password: ""

# Срок хранения событий в часах.
# Тип данных: число
siem.driver_data.storage_time: 72

# Идентификатор consumer-группы Kafka, под которой SIEM-коннектор читает
# топик raw.events. По этому имени update-скрипт выдаёт пользователю
# siem.driver_data.user право READ на consumer-группу — без него брокер запретит
# чтение (allow.everyone.if.no.acl.found=false). Значение должно совпадать
# с group.id, настроенным на стороне SIEM-коннектора.
#
# Тип данных: строка
siem.driver_data.consumer_group_id: ""
</file>

