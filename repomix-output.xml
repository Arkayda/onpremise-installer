        final_projects_object[project] = {
            'ip_address': project_host,
            'port': nginx_port,
            'certificate_available_till': int(expire_at)
        }
        

#---КОНЕЦ ВСПОМОГАТЕЛЬНЫХ ФУНКЦИЙ---#

