        max-file: "3"

  # GO_COMPANY_CACHE
  go-company-cache-{{$domino.label}}:
    image: "{{.registry_compass_path}}/go_company_cache:{{$domino.service.go_company_cache.tag}}"
    depends_on:
      - "rabbit-{{$domino.label}}"
      - "mysql-{{$domino.label}}"
    environment:
      TCP_PORT: 1000
      GRPC_PORT: 2000
      RABBIT_QUEUE: {{$domino.service.go_company_cache.rabbit_queue}}
