  # GO_LOCAL_LICENSE
  go-local-license-{{.projects.license.label}}:
    image: "{{.registry_compass_path}}/go_local_license:{{.projects.license.service.go_local_license.tag}}"
    environment:
      HTTP_PORT: 80
    env_file:
      - ".global.common.env"
      - ".project.common.env"
    networks:
      - "license-private"
    <<:
      - *default-deploy
      - *log-rule-default
    healthcheck:
