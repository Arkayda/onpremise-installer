        )
        prefix = (
            (goenv_file_path_elements[1] + ".")
            if goenv_file_path_elements[1] != "variable"
            else ""
        )

        # формируем итоговое имя файла, убирая из расширения префикс «go»
        env_file_name = (
                project_id + "." + prefix + str(goenv_file_name).replace(".goenv", ".env")
