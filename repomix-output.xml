#!/usr/bin/env python3
import os
import sys
from pathlib import Path

import yaml

current_dir = os.path.dirname(os.path.abspath(__file__))
parent_dir = os.path.abspath(os.path.join(current_dir, '..'))
sys.path.insert(0, parent_dir)

from utils import scriptutils

# region АРГУМЕНТЫ СКРИПТА #
parser = scriptutils.create_parser(
    description="Скрипт для проверки, что репликация запущена не на RPM системе.",
    usage="python3 script/replication/validate_os.py [-v VALUES] [-e ENVIRONMENT]",
    epilog="Пример: python3 script/replication/validate_os.py -v compass -e production",
